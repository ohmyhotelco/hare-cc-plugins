#!/usr/bin/env python3
"""fo-screen-hash — the one definition of "what a screen's gate evidence covers".

Every producer (fo-verify-run, fo-evidence, fo-gen) and every consumer (fo-progress-report,
fo-cutover-check, the gate preconditions) must hash the same path set, or evidence goes stale for
reasons that have nothing to do with the code. This script owns that set:

  + <screensDir>/<screen>/                 the screen's code, tests, mocks, plan, analysis
  - <screensDir>/<screen>/<Screen>.spec.md excluded: gate skills write block 5 of it AFTER recording
                                           evidence, so including it would invalidate every record
  + plan routes[].file                     the route modules the screen owns (auth, loader, meta live there)
  + plan designSystem.gaps[].plannedAs     ui-kit primitives the screen added
  + plan api.additions[].file              package code the screen added

  Not included, on purpose:
  - <app.dir>/e2e/**                       the Playwright specs are WRITTEN BY the visual/e2e/seo gates;
                                           hashing them would make every earlier gate stale the moment a
                                           later gate runs. Each of those gates records its own spec paths
                                           in its evidence instead.
  - shared i18n resources, routes.ts, the MSW aggregate — edited by every screen; including them would
    stale every other screen on each integration. The integration gate's own evidence covers them.

USAGE
  fo-screen-hash --app <name> --screen <id> [--config …] [--paths]
  --paths prints the resolved path list (one per line) instead of the hash, for debugging.
Exit 3 with {"hash": null, "reason": …} when there is nothing to hash yet.
"""
import argparse, json, os, re, subprocess, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from fo_lib import read_json, sibling

def pascal(screen_id):
    return "".join(w.capitalize() for w in re.sub(r"^\d+[a-z]?-", "", screen_id).split("-"))

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--app", required=True); ap.add_argument("--screen", required=True)
    ap.add_argument("--config", default=".claude/frontend-ohmyhotel-plugin.json"); ap.add_argument("--paths", action="store_true")
    a = ap.parse_args()
    cfg = read_json(a.config) or sys.exit("config not found")
    app = next((x for x in cfg["apps"] if x["name"] == a.app), None) or sys.exit(f"app {a.app!r} not in config")
    sdir = os.path.join(app["screensDir"], a.screen)
    spec_md = os.path.join(sdir, f"{pascal(a.screen)}.spec.md")
    paths, excludes = [], []
    if os.path.isdir(sdir):
        paths.append(sdir)
        if os.path.exists(spec_md): excludes.append(spec_md)
    plan = read_json(os.path.join(sdir, "implementation-plan.json")) or {}
    extra = [r.get("file") for r in plan.get("routes", []) or []]
    extra += [g.get("plannedAs") for g in (plan.get("designSystem", {}) or {}).get("gaps", []) or []]
    extra += [x.get("file") for x in (plan.get("api", {}) or {}).get("additions", []) or []]
    for p in extra:
        if p and os.path.exists(p) and not p.startswith(sdir + os.sep) and p not in paths:
            paths.append(p)
    if a.paths:
        print("\n".join(paths + [f"!{e}" for e in excludes])); return
    if not paths:
        print(json.dumps({"hash": None, "reason": "nothing to hash yet"})); sys.exit(3)
    cmd = [sibling("fo-tree-hash")] + [x for e in excludes for x in ("--exclude", e)] + ["--"] + paths
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        sys.stderr.write(r.stderr); sys.exit(r.returncode or 1)
    print(r.stdout.strip().splitlines()[-1])

if __name__ == "__main__":
    main()
