{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/collect.js", "SessionStart"], "timeout": 5 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/collect.js", "UserPromptSubmit"], "timeout": 3 } ] }
    ],
    "PreToolUse": [
      { "matcher": "^Skill$", "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/collect.js", "PreToolUse"], "timeout": 3 } ] }
    ],
    "PostToolUse": [
      { "matcher": "^(Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit)$", "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/collect.js", "PostToolUse"], "timeout": 4 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/collect.js", "SubagentStop"], "timeout": 3 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/collect.js", "Stop"], "async": true, "timeout": 60 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/collect.js", "SessionEnd"], "timeout": 1 } ] }
    ]
  }
}
